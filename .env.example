# Copy to .env and fill in. .env is git-ignored; never commit real values.
# One .env at the repo root serves both apps.

# Local PostgreSQL started by `docker compose up -d db`
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
DATABASE_URL=

# Port the API listens on (apps/api)
API_PORT=

# Model provider key: read only by apps/api, never by apps/web
FIREWORKS_API_KEY=

# Supabase Auth (sign-in only; every other table is ours, through Prisma).
# apps/web: public by design, since the browser signs in with them. Project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# apps/api: the same project URL, used to fetch the signing keys (JWKS) and to check the token issuer
SUPABASE_URL=
# apps/api, tests only: a JWKS JSON the contract tests set themselves.
# Leave empty locally and in production, so keys are fetched from SUPABASE_URL.
SUPABASE_JWKS_JSON=

# Cloudinary media storage: read only by apps/api, which signs uploads. Values are on the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
